# ---------------------------------------------------------------------------
# payment-settlement-lakehouse
# Everything this repo needs lives in this one file: the platform layer
# (postgres, redis, seaweedfs, kafka, clickhouse) used to be inherited from a
# sibling repo through a compose include; it is vendored into this repo's own
# docker-compose.yml now, so its pins and settings are here too.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=naijapay

# Absolute path, filled in by `make bootstrap`.
# ALWAYS QUOTED: this tree lives under a directory with a space in its name,
# and .env is sourced by shell scripts as well as read by docker compose.
PROJECT_ROOT="/CHANGE/ME"

# --- Platform image pins -----------------------------------------------------
# Kafka 4.3.1 is the latest stable line and is KRaft-only (no Zookeeper).
KAFKA_IMAGE=apache/kafka:4.3.1
POSTGRES_IMAGE=postgres:16.10-bookworm
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.9
REDIS_IMAGE=redis:7.4.7-alpine
# Object store. Was MinIO; see docs/adr/0005 for why not.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.46
# S3 client for the bucket-layout init container. Fat image for four `mb`
# calls, but it exits, and it gates on the S3 API rather than an internal RPC.
AWSCLI_IMAGE=amazon/aws-cli:2.36.43

# --- Platform credentials (local only - never reuse these anywhere real) ----
POSTGRES_USER=dataeng
POSTGRES_PASSWORD=dataeng_local_only
POSTGRES_DB=postgres

CLICKHOUSE_USER=dataeng
CLICKHOUSE_PASSWORD=dataeng_local_only
CLICKHOUSE_DB=naijapay

# S3_*, not SEAWEEDFS_*: every consumer speaks plain S3 and none of them care
# which server answers. SeaweedFS reads them as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, so there is no second credentials file to sync.
S3_ACCESS_KEY=dataeng
S3_SECRET_KEY=dataeng_local_only

# --- Platform host port map --------------------------------------------------
# Host-side only; containers reach postgres:5432 over data_network. Moved off
# 5432 because a native Postgres usually owns it.
PORT_POSTGRES=5434
PORT_CLICKHOUSE_HTTP=8123
# 9000 is taken by the S3 API on the host, so the native port is remapped.
PORT_CLICKHOUSE_NATIVE=9100
PORT_REDIS=6379
# Container side is 8333 and never changes; this is the host mapping only.
# Not 9000: php-fpm owns it on any machine running Herd or Valet.
PORT_S3_API=9010
# Filer UI, container port 8888.
PORT_S3_UI=9011
PORT_KAFKA=9092

# --- Platform memory ceilings ------------------------------------------------
# Colima was started with 6 GB. These caps are what keep the VM from
# OOM-killing containers at random.
#
#   core (pg+seaweedfs+redis)  0.76 GB
#   kafka                      0.77 GB
#   clickhouse                 1.28 GB
#   airflow api+sched+dagp     2.71 GB  (scheduler 1.8 GB, holds the Spark driver)
#   ---------------------------------
#   all of the above           5.52 GB  leaves headroom for the docker daemon
#
# That total is the whole budget. If you raise one number, lower another.
MEM_KAFKA=768m
MEM_KAFKA_HEAP="-Xmx384m -Xms384m"
MEM_POSTGRES=320m
MEM_CLICKHOUSE=1280m
MEM_REDIS=96m
# Estimate, not measured. SeaweedFS runs master, volume, filer and S3 in one
# Go process, and Go's GC grows toward whatever ceiling it is given. Check it
# with `make mem` during a Spark write.
MEM_S3=768m

# Fixed so the log dir survives a recreate. Regenerate with: kafka-storage random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

AIRFLOW_BASE_IMAGE=apache/airflow:3.3.1
AIRFLOW_IMAGE=naijapay/airflow:3.3.1-local
# Host UID so files Airflow writes into bind mounts are not root-owned.
AIRFLOW_UID=501

PORT_AIRFLOW=8081

# Spark local-mode driver heap. Must stay comfortably under MEM_AIRFLOW_SCHEDULER.
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=8

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_local_only

# Both MUST be identical across every airflow container. In Airflow 3 the task
# runner authenticates back to the api-server with a JWT; a mismatch surfaces
# as "Invalid auth token: Signature verification failed" and nothing else.
# Generated by `make bootstrap`. Left as placeholders here on purpose: a
# committed example file with real keys in it hands every reader the same
# credentials, and any secret scanner worth the name flags it.
AIRFLOW_JWT_SECRET=GENERATE_ME
AIRFLOW_FERNET_KEY=GENERATE_ME

MEM_AIRFLOW_APISERVER=512m
# 1.8 GB is NOT generous. LocalExecutor runs each task as a subprocess of
# this container, and the local-mode Spark driver JVM is one of those tasks.
# Drop this below ~1.5 GB and the spark task dies with exit code 137.
MEM_AIRFLOW_SCHEDULER=1800m
MEM_AIRFLOW_DAGPROC=400m

# Generator volume. 50k events over 14 simulated days is enough to exercise
# late arrivals and dedupe without needing Spark to actually be necessary.
GEN_EVENT_COUNT=50000
GEN_DAYS=14
GEN_SEED=20260909
