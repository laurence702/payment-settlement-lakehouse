# Profile: large. A 10 GB Docker VM, the most this project allows itself. Same
# as medium with a bigger Spark driver and scheduler ceiling. Ceilings sum to
# about 10 GiB. Use only if medium has been run and failed on memory.
#
# Applied to .env by `make profile PROFILE=large`.
MEM_KAFKA=768m
MEM_KAFKA_HEAP="-Xmx384m -Xms384m"
MEM_POSTGRES=320m
MEM_CLICKHOUSE=2560m
MEM_REDIS=48m
MEM_S3=1024m
S3_GOMEMLIMIT=768MiB
MEM_AIRFLOW_APISERVER=448m
MEM_AIRFLOW_SCHEDULER=5120m
MEM_AIRFLOW_DAGPROC=384m
MEM_OPS=128m
SPARK_DRIVER_MEMORY=3g
SPARK_SHUFFLE_PARTITIONS=32
GEN_EVENT_COUNT=50000
