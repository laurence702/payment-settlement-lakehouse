# Profile: small. A 6 GB Docker VM, the project's default and its design
# constraint. Fine for tens of thousands to roughly 200k events; beyond that the
# container ceilings, not the pipeline, decide whether a run finishes.
#
# Applied to .env by `make profile PROFILE=small`. Only the keys listed here are
# touched. Ceilings sum to about 5.5 GB; see docs/adr/0003 before changing any.
MEM_KAFKA=768m
MEM_KAFKA_HEAP="-Xmx384m -Xms384m"
MEM_POSTGRES=320m
MEM_CLICKHOUSE=1280m
MEM_REDIS=48m
MEM_S3=1024m
S3_GOMEMLIMIT=768MiB
MEM_AIRFLOW_APISERVER=448m
MEM_AIRFLOW_SCHEDULER=1800m
MEM_AIRFLOW_DAGPROC=384m
MEM_OPS=128m
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=8
GEN_EVENT_COUNT=50000
