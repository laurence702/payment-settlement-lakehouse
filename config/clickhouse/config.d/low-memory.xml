<clickhouse>
    <!-- Sized for a 1200m container inside a 6 GB Colima VM. ClickHouse will
         happily assume it owns the machine otherwise and get OOM-killed. -->
    <max_server_memory_usage>1200000000</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <listen_host>0.0.0.0</listen_host>
    <max_concurrent_queries>16</max_concurrent_queries>
    <!-- Restored 2026-09-15: removing these let ClickHouse auto-scale its
         background thread pools to defaults (BackgroundSchedulePoolSize=512
         observed), which tracked with MemoryResident sitting at/above the
         1200m cgroup limit and jemalloc.resident near 1.95 GB even though the
         query-level MemoryTracking metric was only ~129 MB. That is
         allocator/background overhead, not query load, and it is exactly the
         OOM risk this file exists to prevent. -->
    <background_pool_size>4</background_pool_size>
    <background_schedule_pool_size>4</background_schedule_pool_size>

    <logger>
        <level>warning</level>
    </logger>
    <!-- Native Prometheus endpoint. This is why Prometheus has something real
         to scrape without bolting on an exporter sidecar. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
